# --- AI Providers ---
# DeepSeek (default pitch engine; USE_GEMINI=False)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini (alternative pitch engine; set USE_GEMINI=True)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Scraper Backends ---
# Apify token for the Apify Google Search Scraper actor (USE_APIFY=True).
# Leave blank to use the free DuckDuckGo backend.
APIFY_API_KEY=your_apify_api_key_here

# --- Feature Flags ---
# True -> Gemini, False -> DeepSeek
USE_GEMINI=False
# True -> Apify, False -> DuckDuckGo
USE_APIFY=False

# --- Storage ---
DB_PATH=cyprus_leads.db
